{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' | grep -qE 'git commit' && bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/roadmap-check.sh\" || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST -H 'Content-type: application/json' --data \"{\\\"text\\\":\\\"⚠️ *Claude 입력 대기 중*\\\\n• *내용*: ${message}\\\\n• *디렉토리*: ${cwd}\\\"}\" '$SLACK_WEBHOOK_URL'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7-plugin@context7-marketplace": true,
    "session-report@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "serena@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "notion@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  }
}
